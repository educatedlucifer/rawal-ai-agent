# Rawal AI configuration template
# Copy to backend/.env for local use. Never commit backend/.env.

# ---- application ------------------------------------------------------------
ENV=dev
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Comma-separated origins, or * only for trusted local development.
CORS_ORIGINS=*

# ---- authentication and signing --------------------------------------------
# IMPORTANT: These must be set to strong random values in production!
# Use: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=72
# Empty means open local mode. Set a strong value for any public deployment.
AUTH_PASSWORD=
AUTH_USERNAME=rawal
# Keep false unless the instance is intentionally anonymous and private.
ALLOW_ANONYMOUS=false

# ---- persistence ------------------------------------------------------------
DATA_DIR=./data
WORKSPACE_ROOT=./data/workspaces
# Optional async SQL URL. Empty uses SQLite at DATA_DIR/rawal.db (legacy bhati.db auto-migrated).
DATABASE_URL=
# MONGO_URI and MONGODB_URI are accepted aliases; MongoDB is recommended on Render.
MONGO_URI=
MONGODB_URI=
DATABASE_NAME=rawal_ai
MONGODB_DB_NAME=
# Optional Google Drive workspace archive credentials (raw or base64 JSON).
GDRIVE_CREDENTIALS_JSON=
GDRIVE_FOLDER_ID=

# ---- default model ----------------------------------------------------------
DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=600
MAX_AGENT_STEPS=80
MAX_CONTEXT_TOKENS=160000
COMPACT_AT_RATIO=0.75

# ---- sandbox (Celesto computers) --------------------------------------------
# auto = Celesto local microVM when the SDK is installed, else host-local.
# celesto = isolated local microVM (needs `celesto doctor` on the host).
# cloud = Celesto Cloud (needs CELESTO_API_KEY).
# local = path-confined host process (tests / hosts without virtualization).
SANDBOX_BACKEND=auto
SANDBOX_IMAGE=celesto-microvm
SANDBOX_FALLBACK_IMAGE=celesto-microvm
SANDBOX_CPUS=1.0
SANDBOX_MEMORY_MB=2048
SANDBOX_IDLE_TIMEOUT_S=1800
SANDBOX_NETWORK=bridge
SANDBOX_COMMAND_TIMEOUT_S=300
CELESTO_API_KEY=
CELESTO_API_URL=https://api.celesto.ai
# Optional remote Chromium over CDP. Set this on Render to keep browser RAM off
# the API container; leave empty to use local Playwright Chromium.
BROWSER_CDP_URL=
BROWSER_MAX_SESSIONS=1
BROWSER_IDLE_TIMEOUT_S=900

# ---- integrations -----------------------------------------------------------
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
VERCEL_TOKEN=
RENDER_TOKEN=
HF_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# ---- web search -------------------------------------------------------------
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---- email transcript sharing -----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
